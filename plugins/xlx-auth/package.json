{
  "name": "dsh-xlx-auth",
  "version": "0.1.0",
  "description": "Local accounts, role grants, and MCP OAuth authorization for DeepSeek Harness Web",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "README.md",
    "examples"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@node-oauth/oauth2-server": "5.3.1",
    "zod": "4.6.6"
  }
}
